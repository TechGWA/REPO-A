<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="bottom"
    android:id="@id/card_view_no_app"
    android:background="@drawable/cta_area_dra"
    android:visibility="gone"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/ad_200dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <Button
        android:textSize="@dimen/cta_button_text_size18"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@id/cta_button"
        android:background="@drawable/cta_press_selector"
        android:paddingLeft="@dimen/ad_32dp"
        android:paddingTop="@dimen/cta_button_margin_top12"
        android:paddingRight="@dimen/ad_32dp"
        android:paddingBottom="@dimen/cta_button_margin_bottom12"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View More"
        android:maxEms="15"
        android:singleLine="true"
        android:layout_centerInParent="true"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />
    <ImageView
        android:id="@id/ed_ad_icon"
        android:background="@color/black"
        android:layout_width="56.0dip"
        android:layout_height="10.0dip"
        android:layout_marginRight="@dimen/ad_4dp"
        android:layout_marginBottom="@dimen/ad_4dp"
        android:src="@mipmap/zmaticoo_ad_icon"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true" />
</RelativeLayout>