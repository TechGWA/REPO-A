<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/video_header_view"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/video_header_view_margin15"
    android:layout_marginTop="@dimen/ad_25dp"
    android:layout_marginRight="@dimen/video_header_view_margin15"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/volume_fra"
        android:background="@drawable/browser_forwrad"
        android:paddingLeft="@dimen/ad_10dp"
        android:paddingTop="@dimen/ad_6dp"
        android:paddingRight="@dimen/ad_10dp"
        android:paddingBottom="@dimen/ad_6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/btn_back"
            android:layout_width="@dimen/ad_20dp"
            android:layout_height="@dimen/ad_20dp"
            android:src="@mipmap/zmaticoo_browser_left"
            android:text="Back" />
        <ImageView
            android:layout_width="@dimen/ad_20dp"
            android:layout_height="@dimen/ad_20dp"
            android:src="@mipmap/zmaticoo_rectangle" />
        <ImageView
            android:id="@id/btn_forward"
            android:layout_width="@dimen/ad_20dp"
            android:layout_height="@dimen/ad_20dp"
            android:src="@mipmap/zmaticoo_browser_right" />
    </LinearLayout>
    <View
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_weight="1.0" />
    <ImageView
        android:id="@id/btn_refresh"
        android:layout_width="@dimen/ad_20dp"
        android:layout_height="@dimen/ad_20dp"
        android:src="@mipmap/zmaticoo_refresh" />
    <ImageView
        android:id="@id/ad_close"
        android:visibility="visible"
        android:layout_width="@dimen/ad_20dp"
        android:layout_height="@dimen/ad_20dp"
        android:layout_marginLeft="@dimen/ad_close_margin_left_6dp"
        android:src="@mipmap/zmaticoo_b_close" />
</LinearLayout>